{
  "expo": {
    "name": "Salcara AI",
    "slug": "salcara-image-mobile",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "top.salcara.image",
      "buildNumber": "20",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Salcara AI 需要使用麦克风来听你说话，录音只用于语音输入和语音对话。",
        "NSCameraUsageDescription": "允许 Salcara AI 拍摄参考图片。",
        "NSPhotoLibraryUsageDescription": "允许 Salcara AI 读取你选择的图片。",
        "NSPhotoLibraryAddUsageDescription": "允许 Salcara AI 将生成图片保存到相册。",
        "NSCalendarsUsageDescription": "你确认日程卡片后，Salcara AI 会把这条日程添加到系统日历。",
        "NSCalendarsWriteOnlyAccessUsageDescription": "你确认日程卡片后，Salcara AI 会把这条日程添加到系统日历，不会读取你已有的日程。",
        "NSCalendarsFullAccessUsageDescription": "你确认日程卡片后，Salcara AI 会把这条日程添加到系统日历，不会读取或修改你已有的日程。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "top.salcara.image",
      "versionCode": 20,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.android.alarm.permission.SET_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F5F6FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Salcara AI 读取你选择的图片。",
          "cameraPermission": "允许 Salcara AI 拍摄参考图片。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许 Salcara AI 访问你选择的图片。",
          "savePhotosPermission": "允许 Salcara AI 将生成图片保存到相册。"
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
