<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Android 13+: runtime permission, asked only after the user sends a first remote task. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Keeps the process alive while a remote task runs, or (后台待命) while the person
       chose to stay reachable on a phone that cannot receive push. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <application>
    <service
      android:name="expo.modules.salcaranotify.SalcaraWatchService"
      android:exported="false"
      android:foregroundServiceType="dataSync|remoteMessaging" />
    <!-- Firebase Cloud Messaging: the Hub's task news (data messages, no task text). -->
    <service
      android:name="expo.modules.salcaranotify.SalcaraPushService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
